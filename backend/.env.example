# Free demonstration profile. Copy to .env.local for local development only.
APP_ENV=development
STORAGE_MODE=memory
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.siliconflow.cn
ANTHROPIC_MODEL=deepseek-ai/DeepSeek-V3.2
APP_ACCESS_TOKEN=
# Set true only for a public demo. Model rate/concurrency limits still apply.
PUBLIC_DEMO=false
FRONTEND_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
PROMETHEUS_PORT=0
MONITOR_INTERVAL=10
# STORAGE_MODE=full requires the original Redis/Chroma dependencies and settings.
